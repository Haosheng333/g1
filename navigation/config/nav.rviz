Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Value: true
    - Class: rviz/Map
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Value: true
    - Class: rviz/Map
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
      Value: true
    - Class: rviz/Path
      Name: Global Plan
      Topic: /move_base/DWAPlannerROS/global_plan
      Value: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Value: false
  Global Options:
    Fixed Frame: map
