<launch>
    <!-- Map & Frame Arguments -->
    <arg name="map_file" default="$(find g1_navigation)/maps/map.yaml"/>
    <arg name="global_frame" default="camera_init" />
    <arg name="robot_frame" default="pelvis" />

    <!-- Map Server serving occupancy grid in camera_init frame -->
    <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)">
        <param name="frame_id" value="$(arg global_frame)" />
    </node>

    <!-- Hardware Joint State Bridge Node (§4a interface compliance) -->
    <node pkg="g1_navigation" type="g1_joint_state_bridge.py" name="g1_joint_state_bridge" output="screen" />

    <!-- Core Navigation Node (§4b pelvis root frame alignment) -->
    <node pkg="g1_navigation" type="navigation_node.py" name="navigation_node" output="screen">
        <param name="global_frame" value="$(arg global_frame)" />
        <param name="robot_frame" value="$(arg robot_frame)" />
    </node>
</launch>
