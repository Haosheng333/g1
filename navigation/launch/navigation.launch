<launch>
  <!-- ONLINE NAVIGATION (doc 4.3). Start AFTER g1_slam localization.launch
       (it provides /map, TF map->camera_init and /slam/manager/state) and a real /joint_states
       (g1_joint_state_bridge.py) - or use system_bringup/launch/navigation.launch which starts all of it.

       roslaunch g1_navigation navigation.launch map_name:=lab
       roslaunch g1_navigation navigation.launch map_name:=lab motion_enabled:=true

       Goals:  rviz "2D Nav Goal" (Fixed Frame = map)  or
               rosservice call /navigation/navigate "{class_name: 'table', approach_distance: 0.6}"
       Status: rostopic echo /navigation/status          Abort: rostopic pub -1 /navigation/cancel std_msgs/Empty "{}"
       Motion: rosservice call /navigation/enable_motion "data: true"

       Parameters live in config/navigation.yaml; launch args below win over the file, the file wins over
       code defaults (doc section 7).  Check live values with `rosparam get /navigation_node`.
  -->
  <arg name="map_name" default="current"/>
  <arg name="maps_dir" default="$(find g1_slam)/maps"/>
  <arg name="semantic_file" default="$(arg maps_dir)/$(arg map_name)/semantic.yaml"/>
  <arg name="global_frame" default="map"/>
  <arg name="robot_frame" default="pelvis"/>
  <arg name="use_localization_gate" default="true"/>
  <arg name="motion_enabled" default="false"/>
  <!-- false in the simulator, which publishes /obstacle_cloud itself -->
  <arg name="obstacle_cloud" default="true"/>

  <node pkg="g1_navigation" type="obstacle_cloud_node.py" name="obstacle_cloud_node" output="screen"
        if="$(arg obstacle_cloud)">
    <param name="manifest" value="$(arg maps_dir)/$(arg map_name)/manifest.yaml"/>
    <param name="map_frame" value="$(arg global_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
  </node>

  <node pkg="g1_navigation" type="navigation_node.py" name="navigation_node" output="screen">
    <rosparam command="load" file="$(find g1_navigation)/config/navigation.yaml"/>
    <param name="global_frame" value="$(arg global_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="semantic_file" value="$(arg semantic_file)"/>
    <param name="use_localization_gate" type="bool" value="$(arg use_localization_gate)"/>
  </node>

  <node pkg="g1_navigation" type="cmd_vel_gate.py" name="cmd_vel_gate" output="screen">
    <param name="enabled" type="bool" value="$(arg motion_enabled)"/>
    <param name="in_topic" value="/navigation/cmd_vel"/>
    <param name="out_topic" value="/locomotion/cmd_vel"/>
  </node>
</launch>
