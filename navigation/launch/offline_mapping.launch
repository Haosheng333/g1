<launch>
  <arg name="database_path" default="$(find g1_navigation)/maps/rtabmap.db"/>
  <arg name="rviz" default="true"/>

  <!-- 1. Sync RGB-D Image Streams (RealSense) -->
  <node pkg="rtabmap_sync" type="rgbd_sync" name="rgbd_sync" output="screen">
    <remap from="rgb/image"       to="/camera/color/image_raw"/>
    <remap from="depth/image"     to="/camera/aligned_depth_to_color/image_raw"/>
    <remap from="rgb/camera_info" to="/camera/color/camera_info"/>
    <remap from="rgbd_image"      to="/rgbd_image"/>
    <param name="approx_sync"     value="true"/>
  </node>

  <!-- 2. LiDAR ICP Odometry (Livox Mid-360 PointCloud) -->
  <node pkg="rtabmap_odom" type="icp_odometry" name="icp_odometry" output="screen">
    <remap from="scan_cloud" to="/livox/lidar"/>
    <param name="frame_id"        value="base_link"/>
    <param name="odom_frame_id"   value="odom"/>
    <param name="publish_tf"      value="true"/>
    <param name="Icp/PointToPlane" value="true"/>
    <param name="Icp/VoxelSize"   value="0.05"/>
  </node>

  <!-- 3. RTAB-Map SLAM Node (Incremental Mapping) -->
  <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen" args="--delete_db_on_start">
    <param name="database_path"       value="$(arg database_path)"/>
    <param name="frame_id"            value="base_link"/>
    <param name="odom_frame_id"       value="odom"/>
    <param name="map_frame_id"        value="map"/>
    <param name="subscribe_depth"     value="false"/>
    <param name="subscribe_rgbd"      value="true"/>
    <param name="subscribe_scan_cloud" value="true"/>

    <remap from="rgbd_image"          to="/rgbd_image"/>
    <remap from="scan_cloud"          to="/livox/lidar"/>

    <!-- Memory & Loop Closure Params -->
    <param name="Rtabmap/DetectionRate" value="2.0"/>
    <param name="RGBD/NeighborLinkRefining" value="true"/>
    <param name="RGBD/ProximityBySpace" value="true"/>
    <param name="Grid/CellSize" value="0.05"/>
  </node>

  <!-- 4. Map Session Manager Node -->
  <node pkg="g1_navigation" type="map_manager_node.py" name="map_manager" output="screen"/>

  <!-- 5. Visualization -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find rtabmap_viz)/launch/config/rgbd.rviz"/>
</launch>
