<mujoco model="revo2_hand_sim">
  <!--
    Simplified stand-in for the BrainCo Revo2 hand, for developing/testing
    Module 3.2's Trigger-service logic before real hardware is available.

    This is NOT a Revo2 CAD model: it is a generic 5-finger, single-actuator-
    per-finger underactuated hand (proximal + distal joint coupled 1:1 by an
    equality constraint, like a tendon), which is enough to validate:
      - the raw-position (0-1000) <-> joint-angle convention
      - open/close/settle timing and tolerance logic
      - the Trigger service state machine in hand_node.py
    Swap in a real Revo2 MJCF/URDF-converted asset later; hand_sim_link.py
    only needs the actuator/joint names below to stay the same (or update
    the name lists at the top of that file).
  -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.4" armature="0.01" frictionloss="0.02"/>
    <geom rgba="0.72 0.72 0.78 1" friction="1.2 0.02 0.001" density="1200"/>
  </default>

  <worldbody>
    <light pos="0.2 0.2 0.6" dir="-0.3 -0.3 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.05" pos="0 0 0" rgba="0.9 0.9 0.9 1"/>

    <body name="palm" pos="0 0 0.12">
      <geom name="palm_geom" type="box" size="0.045 0.03 0.012" rgba="0.55 0.55 0.6 1"/>

      <!-- five fingers, spread along the palm's front edge (local +y),
           indexed [0=thumb, 1=index, 2=middle, 3=ring, 4=pinky] -->
      <body name="f0_prox" pos="-0.036 0.03 0">
        <joint name="finger0_joint" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0.032 0" size="0.007"/>
        <body name="f0_dist" pos="0 0.032 0">
          <joint name="finger0_joint2" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0.022 0" size="0.006"/>
        </body>
      </body>

      <body name="f1_prox" pos="-0.018 0.03 0">
        <joint name="finger1_joint" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0.038 0" size="0.007"/>
        <body name="f1_dist" pos="0 0.038 0">
          <joint name="finger1_joint2" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0.026 0" size="0.006"/>
        </body>
      </body>

      <body name="f2_prox" pos="0 0.03 0">
        <joint name="finger2_joint" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0.040 0" size="0.007"/>
        <body name="f2_dist" pos="0 0.040 0">
          <joint name="finger2_joint2" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0.027 0" size="0.006"/>
        </body>
      </body>

      <body name="f3_prox" pos="0.018 0.03 0">
        <joint name="finger3_joint" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0.037 0" size="0.007"/>
        <body name="f3_dist" pos="0 0.037 0">
          <joint name="finger3_joint2" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0.025 0" size="0.006"/>
        </body>
      </body>

      <body name="f4_prox" pos="0.036 0.03 0">
        <joint name="finger4_joint" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0.030 0" size="0.006"/>
        <body name="f4_dist" pos="0 0.030 0">
          <joint name="finger4_joint2" type="hinge" axis="1 0 0" range="0 1.3" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0 0.020 0" size="0.005"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- distal joint = proximal joint (1:1 underactuated coupling, tendon-like) -->
  <equality>
    <joint joint1="finger0_joint2" joint2="finger0_joint" polycoef="0 1 0 0 0"/>
    <joint joint1="finger1_joint2" joint2="finger1_joint" polycoef="0 1 0 0 0"/>
    <joint joint1="finger2_joint2" joint2="finger2_joint" polycoef="0 1 0 0 0"/>
    <joint joint1="finger3_joint2" joint2="finger3_joint" polycoef="0 1 0 0 0"/>
    <joint joint1="finger4_joint2" joint2="finger4_joint" polycoef="0 1 0 0 0"/>
  </equality>

  <actuator>
    <position name="finger0_act" joint="finger0_joint" ctrlrange="0 1.3" kp="6" kv="0.3"/>
    <position name="finger1_act" joint="finger1_joint" ctrlrange="0 1.3" kp="6" kv="0.3"/>
    <position name="finger2_act" joint="finger2_joint" ctrlrange="0 1.3" kp="6" kv="0.3"/>
    <position name="finger3_act" joint="finger3_joint" ctrlrange="0 1.3" kp="6" kv="0.3"/>
    <position name="finger4_act" joint="finger4_joint" ctrlrange="0 1.3" kp="6" kv="0.3"/>
  </actuator>
</mujoco>
