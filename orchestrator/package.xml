<?xml version="1.0"?>
<package format="2">
  <name>orchestrator</name>
  <version>0.1.0</version>
  <description>
    Declarative sequencing for the grasp-and-deliver pipeline. Composes the
    other modules' published interfaces and contains no robotics of its own:
    no IK, no TF maths, no planning, no perception, no arm or hand control.
    Execution is dry-run unless launched with enable_motion:=true, preflight
    must pass before any step runs, and the full grasp route stays NOT_READY
    while the perception to arm_planning frame contract is unresolved.
  </description>

  <maintainer email="haochengsun38@gmail.com">Haosheng333</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>

  <!-- Service types the real backend calls. Not needed for a dry run, which
       constructs no client, but required for a motion run. -->
  <exec_depend>g1_navigation</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>hand_control</exec_depend>
  <exec_depend>arm_planning</exec_depend>
  <exec_depend>arm_control</exec_depend>
  <!-- handover/ArmMonitor.srv: the arm request carries side + session_token. -->
  <exec_depend>handover</exec_depend>
  <!-- The spoken command: voice_control publishes g1_voice_control/TaskCommand on
       /voice/command and this node answers with TaskResult. Runtime only; the
       node starts without the voice package built, just without that input. -->
  <exec_depend>g1_voice_control</exec_depend>
  <!-- fetch_deliver: arm_grasp's g1_arm_simple services, standing waypoints
       read through g1_slam.standing_goal, and the PoseStamped goal it builds. -->
  <exec_depend>arm_grasp</exec_depend>
  <exec_depend>g1_slam</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <catkin_python_setup />
  </export>
</package>
