# /orchestrator/run_{grasp,deliver,auto_release}  --  run one declarative route.
#
# SAFETY: execution is DRY-RUN unless the node was launched with
# enable_motion:=true. A dry run constructs no robot service clients at all and
# traverses every step, so a route can be rehearsed with the robot powered off.
# Setting dry_run=true forces a dry run even on a motion-enabled node; there is
# deliberately no field that can force motion ON.
string route         # optional guard: must be empty or match the service's own route
string target        # PICKUP: the semantic waypoint to drive to, and the perception
                     # label to look for there
# DELIVERY: the semantic waypoint to carry the object to. Needed by
# run_deliver_task, which navigates twice -- once to the pickup waypoint before
# perception, once to the delivery point after stowing. Before this field the
# composed task had only one `target` and the delivery drive would have reused
# the pickup waypoint. Empty is REFUSED for a route that has a delivery leg;
# routes with a single leg ignore it.
string destination
# Perception label of the object to pick up ("bottle"). Used by fetch_deliver,
# whose `target` is a STANDING waypoint name and so cannot double as the label
# the way the older routes' `target` does. Empty = the node's ~default_label.
string label
string start_step    # "" = from the beginning; else resume at this step name
bool   dry_run       # true = force a dry run; false = use the node's enable_motion
# Session token issued by HandoverState.mark_awaiting_pull and handed to the
# monitor when it is armed. A release request MUST quote it: without it the
# orchestrator cannot tell a pull detected during THIS handover from one
# detected during an earlier handover and delivered late, because the request
# carries no origin time and stamping its RECEIPT time proves only when it
# arrived. A tokenless release request is refused. See docs/DELIVERY_FLOW.md.
string event_token
---
bool     success
string   message
string[] steps_completed    # step names that ran to completion, in order
string[] steps_skipped      # steps skipped by start_step resume
string[] blockers            # every preflight blocker found; empty when ready
string   final_step          # last step reached (the failing one when success=false)
bool     motion_issued       # true only if a real motion command was actually sent
bool     dry_run             # how the route was actually executed
string   object_state        # NONE | HELD | RELEASE_COMMANDED | UNCERTAIN
bool     transfer_verified   # false unless the hand contract actually established transfer
