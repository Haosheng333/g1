<?xml version="1.0"?>
<package format="2">
  <name>g1_slam</name>
  <version>0.0.1</version>
  <description>G1 SLAM package: Mid-360 LiDAR bring-up, FAST-LIO2 mapping, map save, relocalization against a saved map, tiered /map.</description>

  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roslib</depend>
  <depend>rospy</depend>
  <depend>roslaunch</depend>
  <depend>sensor_msgs</depend>
  <!-- g1_tf_publisher.py consumes FAST-LIO2's /Odometry. -->
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>livox_ros_driver2</depend>
  <exec_depend>fast_lio</exec_depend>

  <!-- g1_tf.launch: robot_description -> pelvis -> torso_link -> mid360_link.
       The URDF itself is vendored in urdf/ (g1_description is a plain directory
       in unitree_ros with no package.xml, so it cannot be a dependency). -->
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- g1_tf_publisher.py and relocalizer.py broadcast / read TF. -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- map_server.launch serves generated 2D maps on /map and /map_metadata. -->
  <exec_depend>map_server</exec_depend>

  <!-- slam_manager.py / relocalizer.py / grid_composer.py -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rospkg</exec_depend>

  <!-- Offline pcd_to_map converter only. -->
  <depend>libpcl-all-dev</depend>

  <!-- test/ is run by catkin_add_nosetests(); nose, not pytest. -->
  <test_depend>python3-nose</test_depend>
</package>
