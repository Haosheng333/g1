<launch>
  <!-- Top-level SLAM bring-up for the G1: starts the Livox Mid-360 driver,
       FAST-LIO2 mapping, and the robot TF tree together in a single roslaunch.

       Composes g1_slam's building-block launch files:
         - sensors.launch          -> livox_ros_driver2 node /livox_lidar_publisher2
                                      (publishes /livox/lidar and /livox/imu)
         - fastlio_mapping.launch  -> fast_lio node /laserMapping
                                      (subscribes to the above, publishes
                                       /Odometry, /cloud_registered, /path, and
                                       TF camera_init -> body)
         - g1_tf.launch            -> robot_state_publisher + /g1_tf_publisher
                                      (robot_description from the vendored URDF,
                                       and dynamic camera_init -> pelvis)

       The Mid-360 is mounted on torso_link and waist_yaw_joint is revolute, so
       camera_init -> pelvis is recomputed every odometry cycle from an EXTERNAL
       /joint_states owned by the robot-control / integration team. Without that
       topic the TF node comes up, warns, and publishes nothing - this bring-up
       still runs, maps, and saves maps as normal.

       camera_init is the Mid-360 IMU pose at the first LiDAR frame and is never
       gravity-aligned. The Mid-360 is mounted upside down on the G1 torso
       (urdf mid360_joint, roll = pi), so camera_init's z axis points INTO the
       floor and everything expressed in it renders flipped. FAST-LIO2's
       extrinsic_R must stay identity (it is the LiDAR-to-IMU relation inside
       the housing), so the correction is a static parent frame instead:
       world -> camera_init, roll = pi, published here. It is a fixed physical
       convention, not a calibration: any residual tilt of the torso at start-up
       (a few degrees) remains in camera_init and is a relocalization concern
       (README section 7). All SLAM outputs stay in camera_init; world only adds
       a z-up view for RViz and downstream consumers.

       RViz is disabled by default so this runs headless (container / robot).
       Neither included file starts RViz on its own; pass rviz:=true to bring up
       rviz/slam.rviz (FAST-LIO2's loam_livox layout with Fixed Frame: world).
       Note the vendored URDF has no meshes, so an RViz RobotModel display would
       render no geometry (see urdf/SOURCE.md). -->

  <arg name="rviz" default="false"/>
  <arg name="rviz_config" default="$(find g1_slam)/rviz/slam.rviz"/>

  <!-- z-up parent of camera_init. Set world_tf:=false if another node (e.g. a
       relocalizer publishing map -> camera_init) owns camera_init's parent. -->
  <arg name="world_tf" default="true"/>
  <arg name="world_frame" default="world"/>

  <!-- Robot TF tree (robot_state_publisher + camera_init -> pelvis). -->
  <arg name="robot_tf" default="true"/>
  <arg name="urdf_file" default="$(find g1_slam)/urdf/g1_23dof_mode_10.urdf"/>
  <!-- Set false if the integration bring-up already runs a robot_state_publisher. -->
  <arg name="robot_state_publisher" default="true"/>

  <!-- Livox Mid-360 driver -->
  <include file="$(find g1_slam)/launch/sensors.launch"/>

  <!-- FAST-LIO2 mapping -->
  <include file="$(find g1_slam)/launch/fastlio_mapping.launch"/>

  <!-- Robot description + dynamic camera_init -> pelvis. Publishes no TF until
       /joint_states carries waist_yaw_joint. -->
  <include file="$(find g1_slam)/launch/g1_tf.launch" if="$(arg robot_tf)">
    <arg name="urdf_file" value="$(arg urdf_file)"/>
    <arg name="robot_state_publisher" value="$(arg robot_state_publisher)"/>
  </include>

  <!-- world -> camera_init: pure 180 deg roll for the inverted Mid-360 mount.
       tf2 static_transform_publisher args: x y z yaw pitch roll parent child. -->
  <node if="$(arg world_tf)" pkg="tf2_ros" type="static_transform_publisher"
        name="world_to_camera_init_tf"
        args="0 0 0 0 0 3.14159265 $(arg world_frame) camera_init"/>

  <!-- Optional visualization, off by default. -->
  <group if="$(arg rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)"
          output="screen"/>
  </group>
</launch>
