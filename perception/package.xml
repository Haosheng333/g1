<?xml version="1.0"?>
<package format="2">
  <name>perception</name>
  <version>0.1.0</version>
  <description>
    Module 1 of the Grasp-and-Deliver pipeline: RGB-D object detection,
    exposing /perception/get_object_position (GetObjectPosition.srv) --
    returns a target object's (x, y, z) in the robot base frame.
  </description>

  <maintainer email="huan0387@e.ntu.edu.sg">huangyiting</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- cv2 is imported directly by the catkin-installed scripts/demo_m1.py -->
  <exec_depend>python3-opencv</exec_depend>
  <!-- launch/perception.launch includes $(find realsense2_camera)/launch/rs_camera.launch,
       so roslaunch cannot resolve this package's launch file without the driver. -->
  <exec_depend>realsense2_camera</exec_depend>
  <!-- launch/perception.launch viewer_window:=true opens /perception/annotated_image -->
  <exec_depend>image_view</exec_depend>

  <export>
    <catkin_python_setup />
  </export>
</package>
