<launch>
  <!-- THE SPOKEN TASK: "go to the desk, pick up a can, go to the chair, and pass me, over"

       Brings up exactly the stack /orchestrator/run_fetch_deliver composes,
       the modules that have been run on this robot, in dependency order:

         navigation.launch   joint bridge, g1_slam localization (map_name),
                             pelvis->base_link alias, g1_navigation (gate SHUT)
         perception.launch   /perception/get_object_position (the D455 driver
                             runs on PC2, see below)
         arm_grasp           g1_arm_simple: NN IK + voxel A* grasp pipeline
         handover.launch     handover_node (arm:=side) + g1_hands' tactile monitor
         orchestrator        /orchestrator/run_fetch_deliver, MOTION ENABLED by default
         voice_control       OFF unless voice_control:=true (Vosk, English model)

       NOT started here, start by hand (they live on PC2 / need a terminal):
         rosrun perception start_remote_camera.sh        # D455 driver on PC2
         rosrun hand_control start_remote_hands.sh       # /g1_hand_<side>/* services
       perception_local_camera:=true starts the driver on this host instead,
       for a camera plugged into the workstation.

       MOTION IS ENABLED BY DEFAULT (enable_motion:=true): a
       run_fetch_deliver call moves the robot once its preflight is clean.
       Navigation's gate starts shut; the route opens it itself and shuts it
       again on every exit path. Rehearse first with enable_motion:=false, or
       with dry_run: true in the request:

         roslaunch system_bringup fetch_deliver.launch map_name:=lab_map_DIP \
             joint_mode:=relay joint_input_topic:=/arm/joint_states
         rosservice call /orchestrator/run_fetch_deliver \
             "{target: table_01, destination: chair_01, label: bottle, dry_run: true}"
         tools/fetch_deliver_check.py        # PASS/WAIT/FAIL per module, relocalization, voice

       target / destination are STANDING waypoint names recorded with
       `rosrun g1_slam record_waypoints.py` into
       slam/maps/<map_name>/standing_waypoints.yaml (lab_map_DIP has table_01
       and chair_01). `side` is the grasping arm and is passed to BOTH the
       orchestrator and handover_node; a mismatch is a preflight blocker.
  -->
  <!-- navigation -->
  <arg name="map_name" default="current"/>
  <arg name="rviz" default="false"/>
  <arg name="with_base_link" default="true"/>
  <arg name="joint_mode" default="relay"/>
  <arg name="joint_input_topic" default=""/>
  <arg name="network_interface" default=""/>
  <arg name="allow_fake_zeros" default="false"/>

  <!-- the grasping arm. left: the right Revo2 is not always up (arm_grasp/README). -->
  <arg name="side" default="left"/>
  <arg name="label" default="bottle"/>

  <!-- perception: the D455 driver runs on PC2 by default (start_remote_camera.sh);
       perception_local_camera:=true starts it on this host instead. -->
  <arg name="perception" default="true"/>
  <arg name="perception_local_camera" default="false"/>
  <arg name="perception_viewer" default="true"/>

  <!-- arm_grasp (g1_arm_simple) -->
  <arg name="arm_grasp" default="true"/>
  <arg name="arm_rviz" default="false"/>
  <!-- handover_node + g1_hands auto_release_monitor -->
  <arg name="handover" default="true"/>
  <arg name="handover_target_xyz" default="[0.35, 0.0, 0.15]"/>

  <!-- orchestrator. enable_motion:=false turns every route into a dry run. -->
  <arg name="orchestrator" default="true"/>
  <arg name="enable_motion" default="true"/>

  <!-- optional voice frontend: disabled, and dry-run against the orchestrator,
       by default. voice_dry_run_backend:=false makes it CALL run_fetch_deliver
       (which is itself a dry run unless enable_motion:=true above). -->
  <arg name="voice_control" default="false"/>
  <arg name="voice_input_mode" default="microphone"/>
  <arg name="voice_input_device" default=""/>
  <arg name="voice_wav_path" default=""/>
  <arg name="voice_dry_run_backend" default="true"/>
  <arg name="voice_confirmation_mode" default="confirm"/>

  <include file="$(find system_bringup)/launch/navigation.launch">
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="motion_enabled" value="false"/>
    <arg name="with_base_link" value="$(arg with_base_link)"/>
    <arg name="joint_mode" value="$(arg joint_mode)"/>
    <arg name="joint_input_topic" value="$(arg joint_input_topic)"/>
    <arg name="network_interface" value="$(arg network_interface)"/>
    <arg name="allow_fake_zeros" value="$(arg allow_fake_zeros)"/>
  </include>

  <include file="$(find perception)/launch/perception.launch" if="$(arg perception)">
    <arg name="local_camera" value="$(arg perception_local_camera)"/>
    <arg name="viewer" value="$(arg perception_viewer)"/>
  </include>

  <include file="$(find arm_grasp)/launch/arm_node_abs.launch" if="$(arg arm_grasp)">
    <arg name="rviz" value="$(arg arm_rviz)"/>
    <arg name="grasp_bottle_arm" value="$(arg side)"/>
    <!-- navigation.launch / SLAM already publish the robot TF. -->
    <arg name="publish_tf_stubs" value="false"/>
  </include>

  <include file="$(find handover)/launch/handover.launch" if="$(arg handover)">
    <arg name="arm" value="$(arg side)"/>
    <arg name="label" value="$(arg label)"/>
    <arg name="target_xyz" value="$(arg handover_target_xyz)"/>
  </include>

  <include file="$(find orchestrator)/launch/orchestrator.launch" if="$(arg orchestrator)">
    <arg name="enable_motion" value="$(arg enable_motion)"/>
    <arg name="side" value="$(arg side)"/>
    <arg name="map_name" value="$(arg map_name)"/>
  </include>

  <include file="$(find g1_voice_control)/launch/voice_control.launch"
           if="$(arg voice_control)">
    <arg name="input_mode" value="$(arg voice_input_mode)"/>
    <arg name="input_device" value="$(arg voice_input_device)"/>
    <arg name="wav_path" value="$(arg voice_wav_path)"/>
    <arg name="dry_run_backend" value="$(arg voice_dry_run_backend)"/>
    <arg name="confirmation_mode" value="$(arg voice_confirmation_mode)"/>
  </include>
</launch>
