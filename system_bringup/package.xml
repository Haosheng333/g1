<?xml version="1.0"?>
<package format="2">
  <name>system_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files that start the other packages together (sensors, navigation, manipulation, full system).</description>

  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>g1_slam</exec_depend>
  <exec_depend>g1_navigation</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Referenced by manipulation.launch / full_system.launch. Every one of
       these is behind an arg that defaults to disabled except arm_planning,
       which is planning only and moves nothing. -->
  <exec_depend>arm_planning</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>hand_control</exec_depend>
  <exec_depend>arm_control</exec_depend>
  <exec_depend>handover</exec_depend>
  <exec_depend>orchestrator</exec_depend>
  <!-- Optional spoken-command frontend. full_system.launch keeps it disabled
       unless voice_control:=true is passed explicitly. -->
  <exec_depend>g1_voice_control</exec_depend>
</package>
